generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
  DRIVER

  @@map("user_role")
}

enum ServiceStatus {
  UNKNOWN
  OK
  DUE_SOON
  OVERDUE

  @@map("vehicle_service_status")
}

enum MaintenanceType {
  OIL_CHANGE
  TIRES
  BRAKES
  INSPECTION
  REPAIR
  OTHER

  @@map("maintenance_type")
}

model Organization {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  users              User[]
  vehicles           Vehicle[]
  drivers            Driver[]
  vehicleAssignments VehicleAssignment[]
  maintenanceRecords MaintenanceRecord[]
  fuelLogs           FuelLog[]

  @@map("organizations")
}

model User {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  firstName      String   @map("first_name")
  lastName       String   @map("last_name")
  /// Stored lowercase; normalized by the application before writes.
  email          String
  /// Argon2id hash. Never return this field from the API.
  passwordHash   String   @map("password_hash")
  /// Least privilege by default; ADMIN manages users, MANAGER and ADMIN write vehicles.
  role           Role     @default(DRIVER)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  driver       Driver?

  // Tenant-scoped uniqueness. The leading organization_id column also serves
  // as the index for "all users in an organization" queries.
  @@unique([organizationId, email])
  @@map("users")
}

model Vehicle {
  id               String        @id @default(uuid(7)) @db.Uuid
  organizationId   String        @map("organization_id") @db.Uuid
  makeId           String        @map("make_id") @db.Uuid
  modelId          String        @map("model_id") @db.Uuid
  vehicleTypeId    String        @map("vehicle_type_id") @db.Uuid
  year             Int
  vin              String
  /// Nullable: vehicles may be added to a fleet before they are registered.
  licensePlate     String?       @map("license_plate")
  /// Derived from maintenance records; written only by the maintenance service and the daily job.
  nextServiceDueOn DateTime?     @map("next_service_due_on") @db.Date
  serviceStatus    ServiceStatus @default(UNKNOWN) @map("service_status")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  assignments        VehicleAssignment[]
  maintenanceRecords MaintenanceRecord[]
  fuelLogs           FuelLog[]

  // Restrict: master data is retired, never deleted, and vehicle history must
  // keep its make/model. The model relation is a composite FK on
  // (make_id, model_id), so the database rejects a model from another make.
  vehicleMake  VehicleMake  @relation(fields: [makeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  vehicleModel VehicleModel @relation(fields: [makeId, modelId], references: [makeId, id], onDelete: Restrict, onUpdate: Cascade)
  vehicleType  VehicleType  @relation(fields: [vehicleTypeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  // Tenant-scoped uniqueness: the same physical vehicle may legitimately exist
  // in two organizations (e.g. after a sale), and a global constraint would leak
  // cross-tenant existence. Both indexes lead with organization_id.
  @@unique([organizationId, vin])
  @@unique([organizationId, licensePlate])
  // Tenant filters by make (and model); leads with organization_id like the rest.
  @@index([organizationId, makeId, modelId])
  // Tenant filter by type; leads with organization_id.
  @@index([organizationId, vehicleTypeId])
  @@map("vehicles")
}

// ---------------------------------------------------------------------------
// Vehicle master data (exercise: docs/exercises/vehicle-master-data.md)
//
// These are the FIRST global (non-tenant) tables in FleetOps: no
// organizationId, shared by every organization. That is a deliberate
// exception to the "every table carries organizationId" convention, so record
// why in the comment above each model once you have decided.
// ---------------------------------------------------------------------------

model VehicleMake {
  id        String   @id @default(uuid(7)) @db.Uuid
  /// Display name, e.g. "Mercedes-Benz".
  name      String   @unique
  /// URL-safe identifier, e.g. "mercedes-benz".
  /// Stored lowercase; normalized by the application before writes.
  slug      String   @unique
  /// false = retired: hidden from pick lists for new vehicles, but kept so
  /// existing references stay valid. Makes are retired, never deleted.
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  models   VehicleModel[]
  vehicles Vehicle[]

  @@map("vehicle_makes")
}

model VehicleModel {
  id        String   @id @default(uuid(7)) @db.Uuid
  makeId    String   @map("make_id") @db.Uuid
  /// Display name, e.g. "Land Cruiser". Unique within its make.
  name      String
  /// URL-safe identifier, e.g. "land-cruiser". Unique within its make; stored lowercase.
  slug      String
  /// false = retired. Offered only if the model AND its make are active (derived at query time).
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  vehicles Vehicle[]

  // Restrict: a make with models cannot be deleted (retire it instead).
  make VehicleMake @relation(fields: [makeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  // Unique per make, not globally: the same model name can exist under two
  // makes (e.g. the badge-engineered Sprinter). Leading make_id also indexes
  // the FK and serves "models of a make ORDER BY name".
  @@unique([makeId, name])
  @@unique([makeId, slug])
  // Target of the composite FK from vehicles (make_id, model_id).
  @@unique([makeId, id])
  @@map("vehicle_models")
}

// Global like makes and models: no organizationId, one list shared by every
// organization. A flat list (no parent); the type belongs to the vehicle, not
// to the model, because one model can be built as several body types.
model VehicleType {
  id        String   @id @default(uuid(7)) @db.Uuid
  /// Display name, e.g. "Truck".
  name      String   @unique
  /// URL-safe identifier, e.g. "truck".
  /// Stored lowercase; normalized by the application before writes.
  slug      String   @unique
  /// false = retired: hidden from pick lists, kept for vehicles that use it.
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  vehicles Vehicle[]

  @@map("vehicle_types")
}

model Driver {
  id               String   @id @default(uuid(7)) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  /// Optional login account. SetNull: the driver and its history outlive the account.
  userId           String?  @unique @map("user_id") @db.Uuid
  firstName        String   @map("first_name")
  lastName         String   @map("last_name")
  /// Stored trimmed + uppercase.
  licenseNumber    String   @map("license_number")
  /// Valid through this date (inclusive, UTC).
  licenseExpiresOn DateTime @map("license_expires_on") @db.Date
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user         User?               @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  assignments  VehicleAssignment[]

  @@unique([organizationId, licenseNumber])
  @@map("drivers")
}

model VehicleAssignment {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  vehicleId      String    @map("vehicle_id") @db.Uuid
  driverId       String    @map("driver_id") @db.Uuid
  /// Set by the application (not the DB clock) so endedAt >= startedAt.
  startedAt      DateTime  @map("started_at") @db.Timestamptz(3)
  /// null = active.
  endedAt        DateTime? @map("ended_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  vehicle      Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  driver       Driver       @relation(fields: [driverId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  // At most one active assignment per vehicle and per driver (race-safe).
  @@unique([vehicleId], map: "vehicle_assignments_active_vehicle_key", where: { endedAt: null })
  @@unique([driverId], map: "vehicle_assignments_active_driver_key", where: { endedAt: null })
  @@index([organizationId, vehicleId, startedAt])
  @@index([organizationId, driverId, startedAt])
  @@map("vehicle_assignments")
}

model MaintenanceRecord {
  id               String          @id @default(uuid(7)) @db.Uuid
  organizationId   String          @map("organization_id") @db.Uuid
  vehicleId        String          @map("vehicle_id") @db.Uuid
  type             MaintenanceType
  description      String?
  vendor           String?
  performedOn      DateTime        @map("performed_on") @db.Date
  odometerKm       Int?            @map("odometer_km")
  cost             Decimal         @db.Decimal(12, 2)
  nextServiceDueOn DateTime?       @map("next_service_due_on") @db.Date
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  vehicle      Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([organizationId, vehicleId, performedOn])
  @@map("maintenance_records")
}

model FuelLog {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  vehicleId      String   @map("vehicle_id") @db.Uuid
  fueledOn       DateTime @map("fueled_on") @db.Date
  liters         Decimal  @db.Decimal(8, 3)
  totalCost      Decimal  @map("total_cost") @db.Decimal(12, 2)
  odometerKm     Int?     @map("odometer_km")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  vehicle      Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([organizationId, vehicleId, fueledOn])
  @@map("fuel_logs")
}
