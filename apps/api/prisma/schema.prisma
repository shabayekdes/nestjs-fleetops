generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
  DRIVER

  @@map("user_role")
}

enum ServiceStatus {
  UNKNOWN
  OK
  DUE_SOON
  OVERDUE

  @@map("vehicle_service_status")
}

enum MaintenanceType {
  OIL_CHANGE
  TIRES
  BRAKES
  INSPECTION
  REPAIR
  OTHER

  @@map("maintenance_type")
}

model Organization {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  users              User[]
  vehicles           Vehicle[]
  drivers            Driver[]
  vehicleAssignments VehicleAssignment[]
  maintenanceRecords MaintenanceRecord[]
  fuelLogs           FuelLog[]

  @@map("organizations")
}

model User {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  firstName      String   @map("first_name")
  lastName       String   @map("last_name")
  /// Stored lowercase; normalized by the application before writes.
  email          String
  /// Argon2id hash. Never return this field from the API.
  passwordHash   String   @map("password_hash")
  /// Least privilege by default; ADMIN manages users, MANAGER and ADMIN write vehicles.
  role           Role     @default(DRIVER)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  driver       Driver?

  // Tenant-scoped uniqueness. The leading organization_id column also serves
  // as the index for "all users in an organization" queries.
  @@unique([organizationId, email])
  @@map("users")
}

model Vehicle {
  id               String        @id @default(uuid(7)) @db.Uuid
  organizationId   String        @map("organization_id") @db.Uuid
  make             String
  model            String
  year             Int
  vin              String
  /// Nullable: vehicles may be added to a fleet before they are registered.
  licensePlate     String?       @map("license_plate")
  /// Derived from maintenance records; written only by the maintenance service and the daily job.
  nextServiceDueOn DateTime?     @map("next_service_due_on") @db.Date
  serviceStatus    ServiceStatus @default(UNKNOWN) @map("service_status")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  assignments        VehicleAssignment[]
  maintenanceRecords MaintenanceRecord[]
  fuelLogs           FuelLog[]

  // Tenant-scoped uniqueness: the same physical vehicle may legitimately exist
  // in two organizations (e.g. after a sale), and a global constraint would leak
  // cross-tenant existence. Both indexes lead with organization_id.
  @@unique([organizationId, vin])
  @@unique([organizationId, licensePlate])
  @@map("vehicles")
}

model Driver {
  id               String   @id @default(uuid(7)) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  /// Optional login account. SetNull: the driver and its history outlive the account.
  userId           String?  @unique @map("user_id") @db.Uuid
  firstName        String   @map("first_name")
  lastName         String   @map("last_name")
  /// Stored trimmed + uppercase.
  licenseNumber    String   @map("license_number")
  /// Valid through this date (inclusive, UTC).
  licenseExpiresOn DateTime @map("license_expires_on") @db.Date
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user         User?               @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  assignments  VehicleAssignment[]

  @@unique([organizationId, licenseNumber])
  @@map("drivers")
}

model VehicleAssignment {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  vehicleId      String    @map("vehicle_id") @db.Uuid
  driverId       String    @map("driver_id") @db.Uuid
  /// Set by the application (not the DB clock) so endedAt >= startedAt.
  startedAt      DateTime  @map("started_at") @db.Timestamptz(3)
  /// null = active.
  endedAt        DateTime? @map("ended_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  vehicle      Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  driver       Driver       @relation(fields: [driverId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  // At most one active assignment per vehicle and per driver (race-safe).
  @@unique([vehicleId], map: "vehicle_assignments_active_vehicle_key", where: { endedAt: null })
  @@unique([driverId], map: "vehicle_assignments_active_driver_key", where: { endedAt: null })
  @@index([organizationId, vehicleId, startedAt])
  @@index([organizationId, driverId, startedAt])
  @@map("vehicle_assignments")
}

model MaintenanceRecord {
  id               String          @id @default(uuid(7)) @db.Uuid
  organizationId   String          @map("organization_id") @db.Uuid
  vehicleId        String          @map("vehicle_id") @db.Uuid
  type             MaintenanceType
  description      String?
  vendor           String?
  performedOn      DateTime        @map("performed_on") @db.Date
  odometerKm       Int?            @map("odometer_km")
  cost             Decimal         @db.Decimal(12, 2)
  nextServiceDueOn DateTime?       @map("next_service_due_on") @db.Date
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  vehicle      Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([organizationId, vehicleId, performedOn])
  @@map("maintenance_records")
}

model FuelLog {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  vehicleId      String   @map("vehicle_id") @db.Uuid
  fueledOn       DateTime @map("fueled_on") @db.Date
  liters         Decimal  @db.Decimal(8, 3)
  totalCost      Decimal  @map("total_cost") @db.Decimal(12, 2)
  odometerKm     Int?     @map("odometer_km")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  vehicle      Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([organizationId, vehicleId, fueledOn])
  @@map("fuel_logs")
}
