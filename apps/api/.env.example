# Runtime environment: development | production | test
NODE_ENV=development

# HTTP port the API listens on
PORT=3000

# PostgreSQL connection string
# Local:  postgresql://fleetops:fleetops@localhost:5432/fleetops_dev?schema=public
# Neon:   use the *direct* (non "-pooler") host so Prisma migrations work
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/fleetops_dev?schema=public"

# HS256 signing secret, min 32 chars. Generate with: openssl rand -base64 48
JWT_SECRET=""

# Access token lifetime in seconds (60-86400)
JWT_EXPIRES_IN=900

# Log level: fatal | error | warn | log | debug | verbose
LOG_LEVEL=log

# Rate limiting for login and password change
# Window in seconds (1-3600)
THROTTLE_TTL_SECONDS=60
# Attempts per window per account+IP (login) / per user (password change)
THROTTLE_LIMIT=5
# Attempts per window per IP
THROTTLE_IP_LIMIT=30

# Number of reverse proxies/load balancers in front of the API (0-10).
# 0 = X-Forwarded-For ignored. Set to 1 behind a single load balancer.
# TRUST_PROXY=0
