# Origin of the FleetOps API, without /api/v1 (the client adds it). Server-only.
API_BASE_URL=http://localhost:3000

# Secret that encrypts the session cookie (AES-256-GCM key is derived from it).
# Min 32 characters. Generate with: openssl rand -base64 32
# Changing it signs every user out. Server-only.
SESSION_SECRET=
