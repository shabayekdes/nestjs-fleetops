# Copy to .env.test. Loaded instead of .env when NODE_ENV=test (Jest sets this).
# MUST point at a dedicated, disposable test database — never dev or production.
NODE_ENV=test
PORT=3001
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/fleetops_test?schema=public"

# HS256 signing secret, min 32 chars. Generate with: openssl rand -base64 48
JWT_SECRET="test-only-jwt-secret-change-me-0123456789"

# Access token lifetime in seconds (60-86400)
JWT_EXPIRES_IN=900

# Log level: fatal | error | warn | log | debug | verbose
LOG_LEVEL=warn

# Rate limiting for login and password change
# Window in seconds (1-3600)
THROTTLE_TTL_SECONDS=60
# Attempts per window per account+IP (login) / per user (password change)
THROTTLE_LIMIT=1000
# Attempts per window per IP
THROTTLE_IP_LIMIT=1000
